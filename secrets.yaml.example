# Copy to secrets.yaml (HA) and esphome/devices/secrets.yaml (ESPHome), then fill in.
# NEVER commit the real files — both are gitignored.

# --- WiFi (ESPHome boards) ---
wifi_ssid: "MyNetwork"
wifi_password: "wifi-password-here"
fallback_ap_password: "fallback-ap-password"

# --- ESPHome ---
# Generate a real 32-byte base64 key: https://esphome.io/components/api.html
# (or run: openssl rand -base64 32)
api_encryption_key: "RVhBTVBMRS1LRVktUkVQTEFDRS1NRS0wMTIzNDU2Nzg="
ota_password: "ota-password-here"

# --- MQTT (Mosquitto add-on user) ---
mqtt_username: "mqtt"
mqtt_password: "mqtt-password-here"

# --- Email alerts: SMTP2GO ---
# DOCUMENTATION ONLY — no YAML references these any more. Email now goes through a
# UI SMTP config entry (Settings → Devices & Services → SMTP, service
# "garage_alert_email"), which holds the credentials in the box's .storage and
# exposes one notify entity per recipient sub-entry. Automations call
# notify.send_message against those entities. These keys are kept so a rebuild
# knows what the config entry must contain — see docs/09 "Cabinet alerting".
smtp2go_username: "smtp2go-username"
smtp2go_password: "smtp2go-password"
alert_sender: "alerts@example.com"
alert_email_scott: "scott@example.com"
alert_email_wife: "wife@example.com"

# --- SMS alerts: Twilio SMS (packages/cabinet_alerts.yaml) ---
twilio_account_sid: "ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
twilio_auth_token: "twilio-auth-token-here"
twilio_from_number: "+18776005343"
alert_sms_scott: "+15555550100"
alert_sms_wife: "+15555550101"
